# Yandex Maps JS API 2.1 key — используется для карты и геокодирования
# Получить: https://developer.tech.yandex.ru/ → JavaScript API и HTTP Геокодер
VITE_YANDEX_GEOCODER_KEY=your_api_key_here

# Backend API base URL (по умолчанию проксируется через Vite на localhost:8080)
# VITE_API_BASE_URL=http://localhost:8080/api
