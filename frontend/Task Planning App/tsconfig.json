{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/app/components/map/**/*.ts",
    "src/app/types/task.ts",
    "src/app/utils/yandexMaps.ts",
    "src/app/utils/routeConflicts.ts",
    "src/app/utils/formatters.ts",
    "src/app/utils/tasks.ts",
    "src/app/utils/download.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
