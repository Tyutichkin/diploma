@startuml auth_sequence_refresh
' Сценарий 3: Автоматическое обновление access-токена при получении 401

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 10
skinparam SequenceArrowColor Black
skinparam SequenceParticipantBorderColor Black
skinparam SequenceParticipantBackgroundColor White
skinparam SequenceLifeLineBorderColor Black
skinparam NoteBackgroundColor White
skinparam NoteBorderColor Black
skinparam ArrowFontSize 9
skinparam Padding 4

participant "Браузер\n(React SPA)" as Browser
participant "API-клиент\n(client.ts)" as Client
participant "Сервер\n(Go / Gin)" as Server
database "PostgreSQL" as DB

Browser -> Client : createTask(data)
activate Client

Client -> Server : POST /api/tasks\nAuthorization: Bearer <истёкший токен>
activate Server
Server --> Client : 401 Unauthorized
deactivate Server

note over Client
  Дедупликация: при первом 401
  запускается ровно один запрос
  обновления (остальные ждут
  через общий Promise)
end note

Client -> Server : POST /api/auth/refresh\n{ refreshToken }
activate Server

Server -> DB : SELECT refresh_tokens\nWHERE hash = bcrypt(token)\nAND expires_at > NOW()
activate DB
DB --> Server : { user_id }
deactivate DB

Server -> Server : Сгенерировать\nновый accessToken (15 мин)

Server -> DB : Обновить refresh_tokens
activate DB
DB --> Server : OK
deactivate DB

Server --> Client : 200 OK\n{ accessToken, refreshToken }
deactivate Server

Client -> Client : Обновить сессию\nв localStorage

note over Client
  Исходный запрос повторяется
  автоматически с новым токеном
end note

Client -> Server : POST /api/tasks\nAuthorization: Bearer <новый токен>
activate Server

Server -> DB : INSERT tasks\n{ user_id, address, lat, lon,\n  duration, window_start, window_end }
activate DB
DB --> Server : { id }
deactivate DB

Server --> Client : 201 Created  { task }
deactivate Server

Client --> Browser : Задача создана
deactivate Client

@enduml
