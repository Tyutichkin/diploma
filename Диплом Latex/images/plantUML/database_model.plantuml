@startuml
hide circle
skinparam linetype ortho
skinparam roundcorner 10
skinparam shadowing false

entity "users" as users {
  * id : UUID <<PK>>
  --
  * email : varchar(255) <<UQ>>
  * password_hash : varchar(255)
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "refresh_tokens" as rt {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * token_hash : varchar(255) <<UQ>>
  * expires_at : timestamptz
  * revoked_at : timestamptz <<nullable>>
  * created_at : timestamptz
}

entity "tasks" as tasks {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * title : varchar(200)
  * address_text : varchar(400)
  * latitude : numeric(9,6) <<nullable>>
  * longitude : numeric(9,6) <<nullable>>
  * duration_min : int <<nullable>>
  * window_start_date : date <<nullable>>
  * window_start_time : time <<nullable>>
  * window_end_date : date <<nullable>>
  * window_end_time : time <<nullable>>
  * sort_index : int
  * is_completed : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "routes" as routes {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK, UQ>>
  * algorithm : varchar(50)
  * total_distance_m : int
  * total_travel_sec : int
  * total_service_sec : int
  * total_wait_sec : int
  * computed_at : timestamptz
}

entity "route_stops" as stops {
  * id : UUID <<PK>>
  --
  * route_id : UUID <<FK>>
  * task_id : UUID <<FK>>
  * position : int
  * travel_from_prev_sec : int <<nullable>>
  * arrive_time : timestamptz <<nullable>>
  * service_start_time : timestamptz <<nullable>>
  * service_end_time : timestamptz <<nullable>>
  * wait_sec : int <<nullable>>
}

users ||--o{ tasks : "1 ко многим"
users ||--o| routes : "1 к 0..1"
users ||--o{ rt : "1 ко многим"

routes ||--o{ stops : "1 ко многим"
tasks  ||--o{ stops : "1 ко многим"

entity "Условные обозначения" as legend {
  PK  : Primary Key (первичный ключ)
  FK  : Foreign Key (внешний ключ)
  UQ  : Unique constraint (ограничение по уникальности)
  nullable : допускается NULL значения
  timestamptz : дата и время с часовым поясом
}

@enduml
