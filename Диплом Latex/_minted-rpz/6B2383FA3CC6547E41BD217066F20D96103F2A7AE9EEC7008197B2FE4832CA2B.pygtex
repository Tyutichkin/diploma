\begin{Verbatim}[commandchars=\\\{\}]
Вход: граф G(V, E), startTimeMins
Выход: порядок обхода order[], агрегированная статистика

1.  cur ← startNode(G)              // узел с наиболее ранним временным окном
2.  visited[cur] ← true
3.  order ← [cur]
4.  currentTime ← startTimeMins + duration[cur]

5.  Пока |order| \PYGZlt{} |V|:
    // Проход 1: ближайший достижимый в пределах окна
    a. next ← \PYGZhy{}1; best ← ∞
    b. Для каждого i ∉ visited:
         arrivalMins ← currentTime + travelSec[cur][i] / 60
         Если feasible(i, arrivalMins) И travelSec[cur][i] \PYGZlt{} best:
             best ← travelSec[cur][i]; next ← i
    // Проход 2: резервный — ближайший без учeта окна
    c. Если next = \PYGZhy{}1:
         best ← ∞
         Для каждого i ∉ visited:
             Если travelSec[cur][i] \PYGZlt{} best:
                 best ← travelSec[cur][i]; next ← i
    d. arrivalMins ← currentTime + travelSec[cur][next] / 60
    e. wait ← max(0, windowStart[next] − arrivalMins)
    f. currentTime ← arrivalMins + wait + duration[next]
    g. visited[next] ← true; order.append(next); cur ← next

6.  Вернуть order и статистику

feasible(node i, arrivalMins):
    Если windowEnd[i] = \PYGZhy{}1: вернуть true   // ограничений нет
    Вернуть arrivalMins ≤ windowEnd[i] − duration[i]
\end{Verbatim}
